<?xml version="1.0"?>

<!-- Define o nome do robô -->
<robot name="dummy_boat">

  <!-- Define o link base do robô -->
  <link name="base_link">

    <!-- Define a parte visual do robô -->
    <visual>

      <!-- Define a geometria e o tamanho do robô -->
      <geometry>
        <box size="1.0 0.5 0.3"/> 
      </geometry>

      <!-- Define a cor do robô -->
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>

    <!-- Define a parte de colisão do robô -->
    <collision>
      <geometry>
        <box size="1.0 0.5 0.3"/>
      </geometry>
    </collision>

    <!-- Define a parte de inércia do robô -->
    <inertial>

      <!-- Define a massa do robô -->
      <mass value="10.0"/>

      <!-- Define a inércia do robô -->
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
  </link>
</robot>