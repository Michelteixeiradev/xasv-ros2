<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="madeira_river_simple">

    <!-- ============================================================ -->
    <!-- Plugins obrigatórios do Gazebo Harmonic                      -->
    <!-- ============================================================ -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster" />

    <!-- ============================================================ -->
    <!-- Física (DART — padrão do Harmonic)                           -->
    <!-- ============================================================ -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ============================================================ -->
    <!-- Iluminação                                                   -->
    <!-- ============================================================ -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.85 0.75 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ============================================================ -->
    <!-- Cena                                                         -->
    <!-- ============================================================ -->
    <scene>
      <ambient>0.5 0.5 0.45 1</ambient>
      <background>0.55 0.75 0.95 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <!-- ============================================================ -->
    <!-- Coordenadas esféricas — Rio Madeira (mesmas do ROS1)         -->
    <!-- ============================================================ -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>-21.7784</latitude_deg>
      <longitude_deg>-43.3697</longitude_deg>
      <elevation>90</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- ============================================================ -->
    <!-- Leito do rio (ground plane)                                  -->
    <!-- Escuro, representando o fundo do rio                         -->
    <!-- ============================================================ -->
    <model name="river_bed">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>300 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>300 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.15 0.12 0.08 1</ambient>
            <diffuse>0.2 0.16 0.1 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
      <pose>100 20 -0.1 0 0 0</pose>
    </model>

    <!-- ============================================================ -->
    <!-- Superfície da água                                           -->
    <!-- Plano semi-transparente na z=0 representando o rio           -->
    <!-- ============================================================ -->
    <model name="water_surface">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>300 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.05 0.15 0.2 1</ambient>
            <diffuse>0.1 0.3 0.4 0.85</diffuse>
            <specular>0.4 0.4 0.4 1</specular>
          </material>
        </visual>
      </link>
      <pose>100 20 0.0 0 0 0</pose>
    </model>

    <!-- ============================================================ -->
    <!-- Margem esquerda do rio                                       -->
    <!-- ============================================================ -->
    <model name="left_bank">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>300 20 2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>300 20 2</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.35 0.1 1</ambient>
            <diffuse>0.3 0.5 0.15 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
      <pose>100 -5 -0.5 0 0 0</pose>
    </model>

    <!-- ============================================================ -->
    <!-- Margem direita do rio                                        -->
    <!-- ============================================================ -->
    <model name="right_bank">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>300 20 2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>300 20 2</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.35 0.1 1</ambient>
            <diffuse>0.3 0.5 0.15 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
      <pose>100 50 -0.5 0 0 0</pose>
    </model>

    <!-- ============================================================ -->
    <!-- Bóias / Galhos flutuantes (branche1_buoy)                    -->
    <!-- Cilindros pequenos representando detritos no rio              -->
    <!-- ============================================================ -->
    <model name="buoy_1">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>1.5</radius><length>0.5</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>1.5</radius><length>0.5</length></cylinder>
          </geometry>
          <material>
            <ambient>0.35 0.2 0.1 1</ambient>
            <diffuse>0.5 0.3 0.15 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>10 10 0.1 0 0 0</pose>
    </model>

    <model name="buoy_2">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>1.5</radius><length>0.5</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>1.5</radius><length>0.5</length></cylinder>
          </geometry>
          <material>
            <ambient>0.35 0.2 0.1 1</ambient>
            <diffuse>0.5 0.3 0.15 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>74 15 0.1 0 0 0</pose>
    </model>

    <model name="buoy_3">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>1.5</radius><length>0.5</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>1.5</radius><length>0.5</length></cylinder>
          </geometry>
          <material>
            <ambient>0.35 0.2 0.1 1</ambient>
            <diffuse>0.5 0.3 0.15 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>138 10 0.1 0 0 0</pose>
    </model>

    <!-- ============================================================ -->
    <!-- Troncos flutuantes (trunk2_buoy)                             -->
    <!-- Cilindros deitados representando troncos de árvore           -->
    <!-- ============================================================ -->
    <model name="trunk_1">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <pose>0 0 0 1.57 0 0</pose>
          <geometry>
            <cylinder><radius>1.0</radius><length>7.0</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0 1.57 0 0</pose>
          <geometry>
            <cylinder><radius>1.0</radius><length>7.0</length></cylinder>
          </geometry>
          <material>
            <ambient>0.25 0.15 0.05 1</ambient>
            <diffuse>0.4 0.25 0.1 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>36 15 0.0 0 0 -3</pose>
    </model>

    <model name="trunk_2">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <pose>0 0 0 1.57 0 0</pose>
          <geometry>
            <cylinder><radius>1.0</radius><length>7.0</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0 1.57 0 0</pose>
          <geometry>
            <cylinder><radius>1.0</radius><length>7.0</length></cylinder>
          </geometry>
          <material>
            <ambient>0.25 0.15 0.05 1</ambient>
            <diffuse>0.4 0.25 0.1 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>80 10 0.0 0 0 0</pose>
    </model>

    <model name="trunk_3">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <pose>0 0 0 1.57 0 0</pose>
          <geometry>
            <cylinder><radius>1.0</radius><length>7.0</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0 1.57 0 0</pose>
          <geometry>
            <cylinder><radius>1.0</radius><length>7.0</length></cylinder>
          </geometry>
          <material>
            <ambient>0.25 0.15 0.05 1</ambient>
            <diffuse>0.4 0.25 0.1 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>120 30 0.0 0 0 0</pose>
    </model>

    <!-- ============================================================ -->
    <!-- Casas na margem (house_1)                                    -->
    <!-- Boxes representando construções ribeirinhas                   -->
    <!-- ============================================================ -->
    <model name="house_1">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>6 5 4</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>6 5 4</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.55 0.45 1</ambient>
            <diffuse>0.75 0.7 0.6 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>19 -2 1.5 0 0 0</pose>
    </model>

    <model name="house_2">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>6 5 4</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>6 5 4</size></box>
          </geometry>
          <material>
            <ambient>0.55 0.5 0.4 1</ambient>
            <diffuse>0.7 0.65 0.55 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>57 54 1.5 0 0 0</pose>
    </model>

    <model name="house_3">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>8 6 5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>8 6 5</size></box>
          </geometry>
          <material>
            <ambient>0.5 0.45 0.35 1</ambient>
            <diffuse>0.65 0.6 0.5 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>87 -3 2.0 0 0 0</pose>
    </model>

  </world>
</sdf>
